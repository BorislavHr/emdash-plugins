{
  "name": "@borislavhr/emdash-plugin-indexnow",
  "version": "1.0.0",
  "description": "EmDash CMS plugin: tells search engines through IndexNow when a page is published, unpublished or deleted, from the live site only.",
  "keywords": [
    "emdash",
    "emdash-plugin",
    "cms",
    "indexnow",
    "seo",
    "bing",
    "astro"
  ],
  "license": "MIT",
  "author": {
    "name": "Borislav Hristov",
    "url": "https://europe4u.online"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BorislavHr/emdash-plugins.git",
    "directory": "packages/indexnow"
  },
  "homepage": "https://github.com/BorislavHr/emdash-plugins/tree/main/packages/indexnow#readme",
  "bugs": "https://github.com/BorislavHr/emdash-plugins/issues",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "default": "./dist/plugin.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test \"test/*.test.ts\"",
    "prepublishOnly": "tsc -p tsconfig.json && node --test \"test/*.test.ts\" && tsc -p tsconfig.build.json"
  },
  "peerDependencies": {
    "emdash": ">=1.5.0 <2"
  },
  "devDependencies": {
    "emdash": "1.5.0"
  }
}
